# Copy to .env and set at least one key. Never commit .env.
# Groq, tried first (free at https://console.groq.com/keys):
GROQ_API_KEY=
# Gemini, the backup (free at https://aistudio.google.com/apikey):
GEMINI_API_KEY=

# --- Server only (spec 020); leave unset when running locally ---
# The domain Lyrx answers on, without https:// (for example lyrx.example.com).
LYRX_DOMAIN=
