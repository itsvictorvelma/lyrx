# Development-only lyric authoring tool. Copy to .env.authoring and fill in.
# Use the exact model id shown in Google AI Studio after the "google_genai:" prefix.
AUTHORING_MODEL=google_genai:REPLACE_WITH_GEMINI_FLASH_MODEL_ID
GOOGLE_API_KEY=
AUTHORING_OUTPUT_DIR=./drafts

# Fallback provider:
# AUTHORING_MODEL=groq:REPLACE_WITH_GROQ_MODEL_ID
# GROQ_API_KEY=
