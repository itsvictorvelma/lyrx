# Caddy in front of Subbed (spec 020): gets and renews the HTTPS certificate for SUBBED_DOMAIN,
# redirects HTTP to HTTPS, and passes every request to the app on the private network.
{$SUBBED_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy subbed:8000
}
