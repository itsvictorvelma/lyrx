# Caddy in front of Lyrx (spec 020): gets and renews the HTTPS certificate for LYRX_DOMAIN,
# redirects HTTP to HTTPS, and passes every request to the app on the private network.
{$LYRX_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy lyrx:8000
}
